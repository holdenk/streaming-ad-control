# obs-ad-control.env.example
#
# Sample env file for the OBS integration (contrib/obs_ad_control.py +
# scripts/obs_title_gate.py). Copy it somewhere private, fill it in, and point
# the OBS script's "Env file" property at it:
#
#   cp contrib/obs-ad-control.env.example ~/.config/obs-ad-control.env
#   chmod 600 ~/.config/obs-ad-control.env   # it holds a Reddit session path
#
# Format: one KEY=value per line. Blank lines and #-comments are ignored;
# surrounding quotes are stripped. The gate loads this file but never overrides
# a variable already set in the real environment.

# --- Twitch channel (for reading the live title automatically) --------------
# By default the gate reads your current title from Twitch's PUBLIC endpoint,
# which needs NO credentials — only your channel name (not a secret). This is
# all most setups need.
TWITCH_CHANNEL_LOGIN=your_twitch_login

# Only needed if you switch the title source to "helix" (the official API):
# register an app at https://dev.twitch.tv/console and set both. The public
# source above needs neither.
# TWITCH_CLIENT_ID=your_twitch_client_id
# TWITCH_CLIENT_SECRET=your_twitch_client_secret

# --- What to control --------------------------------------------------------
# Simplest: one Reddit campaign gated on one keyword. Enable the campaign when
# the live title contains TRIGGER_KEYWORD (case-insensitive), pause it
# otherwise.
REDDIT_CAMPAIGN_ID=2543579648345606062
TRIGGER_KEYWORD=Spark

# Or, for multiple keywords / campaigns / networks, drop the two lines above
# and point at a rules file instead (see rules.example.yaml):
# RULES_FILE=/home/you/.config/streaming-ad-control/rules.yaml

# --- Reddit session ---------------------------------------------------------
# Path to the cookie jar you created with scripts/bootstrap_reddit_session.py.
# With this set, the gate runs headlessly off the saved session and needs no
# Reddit username/password.
REDDIT_COOKIE_JAR=/home/you/.reddit_cookie_jar

# Optional: pin the ads account id (from the dashboard URL
# ads.reddit.com/account/<id>/dashboard). Auto-discovered when unset.
# REDDIT_ADS_ACCOUNT_ID=6bfy

# Only needed if you have NO cookie jar and want the gate to log in fresh
# (not recommended headlessly — Reddit tends to CAPTCHA). Bootstrap instead.
# REDDIT_USERNAME=your_reddit_user
# REDDIT_PASSWORD=your_reddit_password

# --- TrafficStars (only if a rule targets it) -------------------------------
# TRAFFICSTARS_API_KEY=your_trafficstars_api_key

# --- Logging ----------------------------------------------------------------
# DEBUG for verbose gate output while you're wiring things up.
LOG_LEVEL=INFO
